[Unit]
Description=vllm-lab console and gateway
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=titan
SupplementaryGroups=docker
WorkingDirectory=/home/titan
Environment=HOME=/home/titan
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/titan/bin/vllm_lab.py ui --no-browser
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
